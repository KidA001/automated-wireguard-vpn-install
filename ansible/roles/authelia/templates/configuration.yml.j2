---
# {{ ansible_managed }}
# Secrets are inline (this file is 0600, root-only). Regenerated on every deploy.
theme: auto
default_2fa_method: totp

server:
  address: tcp://127.0.0.1:9091/

log:
  level: warn
  format: text

ntp:
  # The host keeps time with chrony; don't contact an NTP server from here.
  disable_startup_check: true

telemetry:
  metrics:
    enabled: false

totp:
  disable: false
  issuer: {{ vpn_host }}
  algorithm: SHA1
  digits: 6
  period: 30
  skew: 1

webauthn:
  disable: {{ (not (passkeys | bool)) | lower }}
  enable_passkey_login: false
  display_name: {{ vpn_host }}
  attestation_conveyance_preference: none
  timeout: 60 seconds
  selection_criteria:
    # Allow both built-in (Touch ID, phone) and roaming (YubiKey) authenticators.
    attachment: ''
    discoverability: preferred
    user_verification: preferred

identity_validation:
  reset_password:
    jwt_secret: {{ vault_authelia_jwt_secret | to_json }}

authentication_backend:
  password_reset:
    disable: true
  file:
    path: /config/users.yml
    watch: false
    password:
      algorithm: argon2

access_control:
  default_policy: deny
  rules:
    - domain:
        - {{ wg_host }}
        - {{ adguard_host }}
      policy: two_factor

session:
  secret: {{ vault_authelia_session_secret | to_json }}
  cookies:
    - name: authelia_session
      domain: {{ vpn_host }}
      authelia_url: https://{{ auth_host }}
      default_redirection_url: https://{{ wg_host }}
      same_site: lax
      inactivity: 1h
      expiration: 12h
      remember_me: {{ '-1' if remember_me | string == '0' else remember_me }}

regulation:
  # Ban the attacking address, not your account (a stranger can't lock you out).
  modes:
    - ip
  max_retries: 3
  find_time: 10m
  ban_time: 1h

storage:
  encryption_key: {{ vault_authelia_storage_key | to_json }}
  local:
    path: /config/db.sqlite3

notifier:
  disable_startup_check: true
  filesystem:
    filename: /config/notification.txt

identity_providers:
  oidc:
    hmac_secret: {{ vault_authelia_oidc_hmac | to_json }}
    jwks:
      - key_id: main
        algorithm: RS256
        use: sig
        key: |
          {{ vault_oidc_jwk | trim | indent(10) }}
    clients:
      - client_id: {{ vault_oidc_client_id | to_json }}
        client_name: wg-easy
        client_secret: {{ vault_oidc_client_secret_hash | to_json }}
        public: false
        authorization_policy: two_factor
        consent_mode: implicit
        require_pkce: true
        pkce_challenge_method: S256
        redirect_uris:
          - https://{{ wg_host }}/api/auth/oidc/callback
          - https://{{ wg_host }}/api/auth/oidc/link
        scopes:
          - openid
          - profile
          - email
        response_types:
          - code
        grant_types:
          - authorization_code
        token_endpoint_auth_method: client_secret_post
