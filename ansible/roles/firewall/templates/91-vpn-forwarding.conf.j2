# {{ ansible_managed }}
# Routing for VPN clients.
net.ipv4.ip_forward = 1
net.ipv4.conf.all.src_valid_mark = 1
net.ipv6.conf.all.forwarding = 1
net.ipv6.conf.default.forwarding = 1
# With forwarding on, the kernel ignores router advertisements unless accept_ra=2,
# which would silently drop SLAAC-configured IPv6 on many VPS providers.
net.ipv6.conf.all.accept_ra = 2
net.ipv6.conf.default.accept_ra = 2
net.ipv6.conf.{{ public_iface }}.accept_ra = 2
# Lets AdGuard bind to the tunnel addresses before wg0 exists.
net.ipv4.ip_nonlocal_bind = 1
net.ipv6.ip_nonlocal_bind = 1
