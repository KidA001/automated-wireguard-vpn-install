# {{ ansible_managed }}
[DEFAULT]
backend = systemd
banaction = nftables-multiport
banaction_allports = nftables-allports
# Your own VPN devices are never banned.
ignoreip = 127.0.0.1/8 ::1 {{ wg_ipv4_cidr }} {{ wg_ipv6_cidr }}
bantime = 1h
findtime = 10m
maxretry = 5

[sshd]
enabled = true
port = {{ ([ssh_port | int] + ([ansible_port | default(ssh_port) | int])) | unique | join(',') }}
# "normal" ignores bare connect/disconnects (e.g. ssh-keyscan); key-only SSH makes
# real attacks show up as failed authentication instead.
mode = normal
{% if disable_password_auth | bool %}
maxretry = 5
bantime = 1h
{% else %}
# Password login is enabled: be much stricter.
maxretry = 3
bantime = 24h
{% endif %}

[authelia]
# Failed web sign-ins. Authelia itself also bans an IP after 3 failures (regulation).
enabled = true
backend = systemd
filter = authelia
port = http,https
maxretry = 5
findtime = 10m
bantime = 1h
