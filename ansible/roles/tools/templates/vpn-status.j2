#!/bin/bash
# {{ ansible_managed }}
# vpn-status            health of services, containers and firewall
# vpn-status --auth-code  show the latest one-time code from Authelia (e.g. to register a passkey)
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Run with sudo." >&2; exit 1; }

NOTIFY={{ authelia_dir }}/config/notification.txt

if [[ ${1:-} == --auth-code ]]; then
  if [[ ! -s $NOTIFY ]]; then
    echo "No code yet. Start the action in the browser (e.g. 'Register passkey'), then run this again."
    exit 1
  fi
  # The filesystem notifier keeps only the latest message; show the code and its age.
  echo "Written $(( ($(date +%s) - $(stat -c %Y "$NOTIFY")) / 60 )) minute(s) ago:"
  grep -iE "code|token|link|https://" "$NOTIFY" | sed 's/^[[:space:]]*//' | tail -5
  exit 0
fi

ok() { printf '  \e[32m✔\e[0m %s\n' "$*"; }
bad() { printf '  \e[31m✘\e[0m %s\n' "$*"; }

echo "Services"
for unit in vpn-stack nftables unbound docker chrony vpn-maintenance.timer vpn-heal.timer{{ ' fail2ban' if fail2ban_enabled | bool else '' }}; do
  if systemctl is-active --quiet "$unit"; then ok "$unit"; else bad "$unit ($(systemctl is-active "$unit"))"; fi
done

echo "Containers"
while read -r name status; do
  if [[ $status == *healthy* && $status != *unhealthy* ]]; then ok "$name: $status"; else bad "$name: $status"; fi
done < <(docker ps -a --format '{{ '{{' }}.Names{{ '}}' }} {{ '{{' }}.Status{{ '}}' }}')

echo "WireGuard"
if wg show wg0 >/dev/null 2>&1; then
  ok "wg0 listening on UDP $(wg show wg0 listen-port), $(wg show wg0 peers | wc -l) peer(s)"
else
  bad "wg0 is down"
fi

echo "DNS"
if dig +time=2 +tries=1 @{{ wg_ipv4_addr }} debian.org A | grep -q NOERROR; then ok "AdGuard answers"; else bad "AdGuard not answering"; fi
if dig +time=2 +tries=1 +dnssec @127.0.0.1 debian.org SOA | grep -q ' ad;'; then ok "Unbound validates DNSSEC"; else bad "Unbound/DNSSEC problem"; fi

echo "Web"
for host in {{ auth_host }} {{ wg_host }} {{ adguard_host }}; do
  code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 {{ '--cacert ' ~ extra_ca_file if tls_mode != 'acme' else '' }} \
    --resolve "$host:443:127.0.0.1" "https://$host/")
  [[ $code =~ ^(200|302)$ ]] && ok "https://$host ($code)" || bad "https://$host (HTTP $code)"
done

echo "Maintenance"
next=$(systemctl show vpn-maintenance.timer -p NextElapseUSecRealtime --value)
echo "  next run: ${next:-unknown}"
/usr/local/sbin/vpn-maintenance --status | sed 's/^/  /'
{% if not disable_password_auth | bool %}

printf '\e[33m⚠ SSH password login is enabled. Keys only is much safer (re-run ./deploy.sh).\e[0m\n'
{% endif %}
